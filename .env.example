# Copy this file to .env and fill in real values before running
# `docker compose up -d --build`. Every shop install needs its own copy of
# this file, at minimum with SERVER_LAN_IP changed to that shop's server.

# --- Networking -----------------------------------------------------------
# The LAN IP of the machine Docker is running on (reserve it as a static
# DHCP lease on the shop's router first). Printed table QR codes encode
# this address, so changing it later means reprinting every QR code and
# rebuilding the frontend image.
SERVER_LAN_IP=192.168.1.50

# --- Database ---------------------------------------------------------
POSTGRES_DB=restaurant_billing
POSTGRES_USER=billing_user
POSTGRES_PASSWORD=change-this-password

# --- Backend ------------------------------------------------------------
# A long random string -- e.g. `openssl rand -hex 32`. Every login token is
# signed with this; treat it like a password. The backend refuses to start
# if this is left as the placeholder below or under 32 characters.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d
BILL_NUMBER_PREFIX=INV

# The login cookie isn't marked Secure by default, since this install is
# plain HTTP on the shop's LAN (browsers silently drop Secure cookies over
# HTTP). Only set to "true" if this is ever put behind a reverse proxy that
# terminates HTTPS.
COOKIE_SECURE=false

# Leave "false" -- the bundled postgres service below doesn't have SSL
# enabled. Only set to "true" if DATABASE_URL is ever pointed at an external
# Postgres that terminates TLS itself (rare for this single-shop setup).
DB_SSL=false

# The very first login for this install -- creates the super_admin account
# that can then onboard vendors from /platform. The password must be at
# least 8 characters with a letter and a number -- the backend exits on
# startup if it isn't (see docker-entrypoint.sh's createSuperAdmin step).
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-this-password
