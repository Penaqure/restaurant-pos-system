# Copy this file to .env and fill in real values before running
# `docker compose up -d --build`. Every shop install needs its own copy of
# this file, at minimum with SERVER_LAN_IP changed to that shop's server.

# --- Networking -----------------------------------------------------------
# The LAN IP of the machine Docker is running on (reserve it as a static
# DHCP lease on the shop's router first). Printed table QR codes encode
# this address, so changing it later means reprinting every QR code and
# rebuilding the frontend image.
SERVER_LAN_IP=192.168.1.50

# --- Database ---------------------------------------------------------
POSTGRES_DB=restaurant_billing
POSTGRES_USER=billing_user
POSTGRES_PASSWORD=change-this-password

# --- Backend ------------------------------------------------------------
# A long random string -- e.g. `openssl rand -hex 32`. Every login token is
# signed with this; treat it like a password.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d
BILL_NUMBER_PREFIX=INV

# The very first login for this install -- creates the super_admin account
# that can then onboard vendors from /platform.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-this-password
